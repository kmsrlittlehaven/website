---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  structuredData?: object;
}

const { title, description, canonical, structuredData } = Astro.props;
const ogImage = "https://thelittlehaven.co.in/accomodation.webp";
console.log('DEBUG: Astro.site=', Astro.site, ' import.meta.env.SITE=', import.meta.env.SITE);

const businessInfo = {
  name: "The Little Haven",
  type: "Ladies Hostel",
  address:
    "Near Kalamassery Municipal Office, South Kalamassery, Kochi, Kerala 682033",
  phone: "+91-8547964256",
  whatsapp: "+91-9895011185",
  email: "cheruvilabraham@gmail.com",
};

// Parse address into structured fields for JSON-LD
const addressParts = businessInfo.address.split(",").map((s) => s.trim());
// Expected format: [street1, street2, locality, "Kerala 682033"]
const streetAddress = addressParts
  .slice(0, Math.max(0, addressParts.length - 2))
  .join(", ");
const locality = addressParts[addressParts.length - 2] || "Kalamassery";
const regionAndPostal =
  addressParts[addressParts.length - 1] || "Kerala 682033";
const regionMatch = regionAndPostal.match(/[A-Za-z ]+/);
const postalMatch = regionAndPostal.match(/\b\d{6}\b/);
const addressRegion = regionMatch ? regionMatch[0].trim() : "Kerala";
const postalCode = postalMatch ? postalMatch[0] : undefined;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "@id": "https://thelittlehaven.co.in/#organization",
  name: businessInfo.name,
  alternateName: "The Little Haven Ladies Hostel",
  description:
    "Safe and comfortable ladies hostel in Kalamassery, Kerala. Premium accommodation for working women and students.",
  url: "https://thelittlehaven.co.in",
  logo: "https://thelittlehaven.co.in/logo.png",
  // Prefer JPG/PNG for best compatibility; keep an absolute URL.
  image: ogImage,
  telephone: businessInfo.phone,
  email: businessInfo.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: streetAddress || businessInfo.address,
    addressLocality: locality || "Kalamassery",
    addressRegion: addressRegion || "Kerala",
    ...(postalCode ? { postalCode: postalCode } : {}),
    addressCountry: "IN",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: "10.044913127566895",
    longitude: "76.31524970290742",
  },
  hasMap: "https://www.google.com/maps?q=10.044913127566895,76.31524970290742",
  areaServed: {
    "@type": "City",
    name: "Kalamassery",
  },
  amenityFeature: [
    { "@type": "LocationFeatureSpecification", name: "WiFi", value: true },
    {
      "@type": "LocationFeatureSpecification",
      name: "Hot and Cold water dispenser",
      value: true,
    },
    {
      "@type": "LocationFeatureSpecification",
      name: "Refrigerator",
      value: true,
    },
    {
      "@type": "LocationFeatureSpecification",
      name: "Safety and Security",
      value: true,
    },
    {
      "@type": "LocationFeatureSpecification",
      name: "Drying Area",
      value: true,
    },
    {
      "@type": "LocationFeatureSpecification",
      name: "Study Room",
      value: true,
    },
    { "@type": "LocationFeatureSpecification", name: "Laundry", value: true },
  ],
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://thelittlehaven.co.in/#website",
  url: "https://thelittlehaven.co.in",
  name: businessInfo.name,
  inLanguage: "en-IN",
};
const allSchemas = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    websiteSchema,
    ...(structuredData ? [structuredData] : []),
  ],
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Optional: theme color for nicer UA theming -->
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph (Social & WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="The Little Haven - Ladies Hostel in Kalamassery"
    />
    <meta property="og:site_name" content="The Little Haven" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>

<script>
  import { setupIntersectionObserver } from "../scripts/observe";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupIntersectionObserver);
  } else {
    setupIntersectionObserver();
  }
</script>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
  }

  main {
    min-height: 60vh;
  }
</style>
